      "id": "38e431ea-b833-4cc9-8a19-1fa55a1d8f38",
      "name": "Classify Request with AI",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"request_id\": {\n      \"type\": \"string\"\n    },\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"plumbing\",\n        \"electrical\",\n        \"heating_hvac\",\n        \"appliance\",\n        \"structural\",\n        \"general\",\n        \"other\"\n      ]\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"medium\",\n        \"high\",\n        \"emergency\"\n      ]\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"recommended_team\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Plumbing Team\",\n        \"Electrical Team\",\n        \"HVAC Team\",\n        \"Appliance Team\",\n        \"Structural Team\",\n        \"General Support\"\n      ]\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    },\n    \"classification_reason\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"request_id\",\n    \"category\",\n    \"urgency\",\n    \"summary\",\n    \"recommended_team\",\n    \"confidence\",\n    \"classification_reason\"\n  ],\n  \"additionalProperties\": false\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
