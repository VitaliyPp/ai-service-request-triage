    {
      "parameters": {
        "promptType": "define",
        "text": "=Classify this home-service request.\n\nInput:\n{\n  \"request_id\": \"{{ $('Normalize').item.json.request_id }}\",\n  \"message\": \"{{ $('Normalize').item.json.message }}\",\n  \"location\": \"{{ $('Normalize').item.json.location }}\"\n}\n\nRouting:\nplumbing -> Plumbing Team\nelectrical -> Electrical Team\nheating_hvac -> HVAC Team\nappliance -> Appliance Team\nstructural -> Structural Team\ngeneral or other -> General Support\n\nUse emergency only for immediate danger: uncontrolled flooding, fire, smoke, gas leak, exposed live electricity, or immediate danger to people or property.\n\nDo not invent missing details.\nKeep summary and classification_reason concise.\nReturn only the structured result required by the output parser.",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -112,
        224
